<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.VeggieGrow.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/image"
            android:layout_width="@dimen/list_image"
            android:layout_height="@dimen/list_image"
            android:background="@color/surface_variant"
            android:contentDescription="@string/variety_name"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_leaf" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="A1 — Basil" />

            <TextView
                android:id="@+id/rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/green_accent"
                tools:text="Current rate: 0.09" />

            <TextView
                android:id="@+id/harvest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/grey_300"
                tools:text="Next harvest: 2026-07-01" />
        </LinearLayout>

        <ImageView
            android:id="@+id/alert_badge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/alerts_title"
            android:src="@drawable/ic_alert"
            android:visibility="gone"
            app:tint="@color/alert_amber" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
