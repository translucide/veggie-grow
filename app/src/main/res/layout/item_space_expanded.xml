<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.VeggieGrow.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Rack header: tap opens the rack detail (reservoir, add bin, edit). -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/image"
                android:layout_width="@dimen/list_image"
                android:layout_height="@dimen/list_image"
                android:background="@color/surface_variant"
                android:contentDescription="@string/space_name"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_leaf" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="A — Greenhouse" />

                <TextView
                    android:id="@+id/reservoir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/green_accent"
                    tools:text="Reservoir: ~12 / 20" />
            </LinearLayout>

            <ImageView
                android:id="@+id/alert_badge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/alerts_title"
                android:src="@drawable/ic_alert"
                android:visibility="gone"
                app:tint="@color/alert_amber" />
        </LinearLayout>

        <!-- Bins gallery: tap a thumbnail to open that bin directly. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bins_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_bin_thumb" />

        <TextView
            android:id="@+id/bins_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/no_bins_tap_to_add"
            android:textColor="@color/grey_500"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
